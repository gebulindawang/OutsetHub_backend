{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "起点社区后端接口文档。除注册、登录外,所有接口都需要在请求头携带 Bearer token。\n使用方式:先调用 POST /api/user/login 拿到 token,再点击右上角 Authorize 填入 token 原文(不需要自己加 Bearer 前缀)。\n统一响应约定:成功为 {code:0, msg:\"ok\", data};仅提示信息的成功为 {code:0, msg};失败为 {code:\u003chttp status\u003e, msg},其中 code 与 HTTP 状态码同值。",
        "title": "起点社区 OutsetHub API",
        "contact": {},
        "version": "1.0"
    },
    "host": "127.0.0.1:8080",
    "basePath": "/api",
    "paths": {
        "/article/": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "只返回 status=1 的已发布文章,按创建时间倒序,当前固定 10 条,暂不支持分页与按板块筛选。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "article"
                ],
                "summary": "文章列表",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.ArticleListResp"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 失效",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "作者取自 JWT,不信任请求体里的 user_id。status 不传默认 1 已发布,传 0 表示存草稿。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "article"
                ],
                "summary": "发布文章",
                "parameters": [
                    {
                        "description": "文章内容",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.CreateArticleReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.MsgResp"
                        }
                    },
                    "400": {
                        "description": "缺少 title/content/category_id",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 失效",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    }
                }
            }
        },
        "/article/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "按 ID 查询单篇文章。注意:本接口不校验 status,草稿和已删除的文章也能取到,由调用方自行判断。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "article"
                ],
                "summary": "文章详情",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "文章 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.ArticleResp"
                        }
                    },
                    "400": {
                        "description": "无效的文章 ID",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 失效",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "404": {
                        "description": "文章不存在",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    }
                }
            },
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "仅作者本人可操作。部分更新:只提交需要修改的字段,空字符串视为不修改。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "article"
                ],
                "summary": "编辑文章",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "文章 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "待更新字段",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.UpdateArticleReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.MsgResp"
                        }
                    },
                    "400": {
                        "description": "参数错误或没有可更新的字段",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 失效",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "403": {
                        "description": "只能编辑自己的文章",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "404": {
                        "description": "文章不存在",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "软删除,把 status 置为 2,记录仍留在库中。仅作者本人可操作。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "article"
                ],
                "summary": "删除文章",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "文章 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.MsgResp"
                        }
                    },
                    "400": {
                        "description": "无效的文章 ID",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 失效",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "403": {
                        "description": "只能删除自己的文章",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "404": {
                        "description": "文章不存在",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    }
                }
            }
        },
        "/category/": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "按 sort 升序返回全部板块,登录用户即可读取",
                "produces": [
                    "application/json"
                ],
