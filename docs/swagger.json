                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.MsgResp"
                        }
                    },
                    "400": {
                        "description": "参数错误或板块名已存在",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 失效",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "403": {
                        "description": "需要管理员权限",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    }
                }
            }
        },
