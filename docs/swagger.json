                        }
                    },
                    "403": {
                        "description": "需要管理员权限",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrResp"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "仅管理员可调用。物理删除,不校验是否仍有文章引用该板块。",
                "produces": [
