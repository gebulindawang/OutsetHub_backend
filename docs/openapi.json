{
  "openapi": "3.0.3",
  "info": {
    "title": "起点社区 OutsetHub API",
    "description": "Go + Gin 后端接口文档。除注册和登录外,所有接口都需要在 Authorization 头携带 Bearer token。",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://127.0.0.1:8080" }
  ],
  "tags": [
    { "name": "user", "description": "注册 / 登录 / 当前用户" },
    { "name": "article", "description": "文章 CRUD" },
    { "name": "category", "description": "板块 CRUD" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/user/register": {
      "post": {
        "tags": ["user"],
        "summary": "注册",
        "operationId": "register",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" },
                  "nickname": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/user/login": {
      "post": {
        "tags": ["user"],
        "summary": "登录,返回 JWT",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "msg": { "type": "string" },
                    "token": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/user/me": {
      "get": {
        "tags": ["user"],
        "summary": "当前登录用户信息",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "msg": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/article": {
      "get": {
        "tags": ["article"],
        "summary": "文章列表(已发布,最新 10 篇)",
        "operationId": "listArticles",
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "msg": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Article" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["article"],
        "summary": "发布文章(作者取自 token)",
        "operationId": "createArticle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "content", "category_id"],
                "properties": {
                  "title": { "type": "string" },
                  "summary": { "type": "string" },
                  "content": { "type": "string" },
                  "category_id": { "type": "integer" },
                  "status": {
                    "type": "integer",
                    "description": "不传默认 1 已发布;0 草稿"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "发布成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/article/{id}": {
      "get": {
        "tags": ["article"],
        "summary": "文章详情",
        "operationId": "getArticle",
        "parameters": [{ "$ref": "#/components/parameters/ArticleID" }],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "msg": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Article" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "文章不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["article"],
        "summary": "编辑文章(仅作者本人)",
        "operationId": "updateArticle",
        "parameters": [{ "$ref": "#/components/parameters/ArticleID" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "部分更新,传哪个字段改哪个",
                "properties": {
                  "title": { "type": "string" },
                  "summary": { "type": "string" },
                  "content": { "type": "string" },
                  "category_id": { "type": "integer" },
                  "status": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "只能编辑自己的文章",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          },
          "404": {
            "description": "文章不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["article"],
        "summary": "删除文章(仅作者本人,软删除 status=2)",
        "operationId": "deleteArticle",
        "parameters": [{ "$ref": "#/components/parameters/ArticleID" }],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "只能删除自己的文章",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          },
          "404": {
            "description": "文章不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          }
        }
      }
    },
    "/api/category": {
      "get": {
        "tags": ["category"],
        "summary": "板块列表(按 sort 升序)",
        "operationId": "listCategories",
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "msg": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Category" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["category"],
        "summary": "新建板块(管理员)",
        "operationId": "createCategory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "maxLength": 50 },
                  "sort": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          },
          "400": {
            "description": "参数错误或分类名已存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrResp" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/category/{id}": {
      "put": {
        "tags": ["category"],
        "summary": "修改板块(管理员,部分更新)",
        "operationId": "updateCategory",
        "parameters": [{ "$ref": "#/components/parameters/CategoryID" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "maxLength": 50 },
                  "sort": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "delete": {
        "tags": ["category"],
        "summary": "删除板块(管理员)",
        "operationId": "deleteCategory",
        "parameters": [{ "$ref": "#/components/parameters/CategoryID" }],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MsgResp" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "ArticleID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "format": "int64" }
      },
      "CategoryID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "nickname": { "type": "string" },
          "role": { "type": "integer", "description": "0普通用户 1管理员" }
        }
      },
      "Article": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "content": { "type": "string" },
          "user_id": { "type": "integer" },
          "category_id": { "type": "integer" },
          "view_count": { "type": "integer" },
          "like_count": { "type": "integer" },
          "comment_count": { "type": "integer" },
          "status": { "type": "integer", "description": "0草稿 1已发布 2已删除" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "sort": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "MsgResp": {
        "type": "object",
        "properties": {
          "msg": { "type": "string" }
        }
      },
      "ErrResp": {
        "type": "object",
        "properties": {
          "msg": { "type": "string" },
          "err": { "type": "string" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "参数错误",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrResp" }
          }
        }
      },
      "Unauthorized": {
        "description": "未登录或 token 失效",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": { "type": "integer" },
                "msg": { "type": "string" }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "需要管理员权限",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": { "type": "integer" },
                "msg": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
